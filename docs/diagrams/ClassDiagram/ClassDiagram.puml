@startuml
title IntelliSolve - Class / Module Diagram
class Home <<React component>> {
 -canvasRef: HTMLCanvasElement
 -dictOfVars: object
 -result: GeneratedResult
 -tool: Tool
 +startDrawing(event)
 +draw(event)
 +stopDrawing(event)
 +undo()
 +redo()
 +resetCanvas()
 +runRoute()
 +renderLatexToCanvas(expression, answer)
}
class GeneratedResult <<TypeScript interface>> {
 +expression: string
 +answer: string
}
class Response <<TypeScript interface>> {
 +expr: string
 +result: string
 +assign: boolean
}
class ImageData <<Pydantic model>> {
 +image: str
 +dict_of_vars: dict
}
class FastAPIApp <<main.py>> {
 +root()
 +lifespan(app)
}
class CalculatorRouter <<route.py>> {
 +run(data: ImageData)
}
class CalculatorUtils <<utils.py>> {
 +analyze_image(img, dict_of_vars)
}
class GeminiGenerativeModel {
 +generate_content(prompt, image)
}
Home --> GeneratedResult
Home ..> Response : consumes JSON data
FastAPIApp --> CalculatorRouter : includes /calculate
CalculatorRouter --> ImageData : validates
CalculatorRouter --> CalculatorUtils : calls
CalculatorUtils --> GeminiGenerativeModel : sends prompt + image
CalculatorRouter --> Home : JSON response via Axios
@enduml