@startuml
title IntelliSolve - Component Diagram
actor User
component "React + TypeScript UI\nVite" as UI
component "Drawing Canvas\nPen, line, rectangle, circle, eraser, text" as Canvas
component "Canvas Controls\nUndo, redo, reset, save" as Controls
component "MathJax + Draggable\nAnswer overlays" as Overlay
component "Axios HTTP Client" as Axios
component "FastAPI Application" as API
component "Calculator Router\nPOST /calculate" as Route
component "ImageData Schema" as Schema
component "Pillow" as Pillow
component "Gemini Generative AI" as Gemini
database "Assigned Variables\ndict_of_vars" as Vars
User --> UI
UI --> Canvas
UI --> Controls
UI --> Overlay
UI --> Axios
Axios --> API : HTTP POST
API --> Route
Route --> Schema : validate request
Route --> Pillow : decode/open image
Route --> Gemini : image + prompt + variables
Vars --> Gemini
Gemini --> Route : generated text
Route --> Axios : JSON response
Axios --> Overlay : expressions / results
@enduml