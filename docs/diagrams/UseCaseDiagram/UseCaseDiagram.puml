@startuml
title IntelliSolve - Use Case Diagram
left to right direction
actor User
rectangle "IntelliSolve" {
 usecase "Draw mathematical / graphical problem" as UC1
 usecase "Choose pen, line, rectangle, circle, eraser or text" as UC2
 usecase "Undo / redo / reset canvas" as UC3
 usecase "Save drawing as PNG" as UC4
 usecase "Submit drawing for solving" as UC5
 usecase "Interpret image using Gemini and assigned variables" as UC6
 usecase "View generated expression and answer" as UC7
}
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
UC5 --> UC6 : <<include>>
UC6 --> UC7 : <<include>>
@enduml